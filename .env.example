# IMPORTANTE: Este archivo NO debe subirse a Git
# Copia este archivo como .env.local y reemplaza los valores con tus credenciales reales de EmailJS

# EmailJS Configuration
# Obtén estos valores en https://dashboard.emailjs.com/

# Service ID - Lo obtienes en "Email Services"
NEXT_PUBLIC_EMAILJS_SERVICE_ID=YOUR_SERVICE_ID

# Template ID - Lo obtienes en "Email Templates"
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=YOUR_TEMPLATE_ID

# Public Key (User ID) - Lo obtienes en "Account" > "General"
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=YOUR_PUBLIC_KEY
